{
  "name": "smash-queue",
  "version": "1.2.0",
  "private": true,
  "description": "Badminton Queue & Game Management Platform — by AIOps (aiops.ae)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "predev": "node scripts/build-guide.mjs",
    "build": "next build",
    "prebuild": "node scripts/build-guide.mjs",
    "start": "next start -p ${PORT:-3000}",
    "guide": "node scripts/build-guide.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:grant-admin": "tsx src/db/grant-admin.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "tsx src/lib/__tests__/run.ts",
    "sim": "tsx src/lib/__tests__/simulate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "marked": "^18.0.13",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
