# Neon Postgres connection string (pooled). Get it from the Neon console or
# from the Vercel integration, which sets it automatically in deployments.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Signs the session QR check-in tokens. Set a long random string in production:
#   openssl rand -base64 32
QR_SECRET=change-me-before-you-share-a-real-session

# Sends the sign-in code and link that staff and organizers use. Get a key
# from resend.com and verify the domain you send from. Leave it unset locally:
# the development build prints the code and link on the sign-in screen and to
# the server log instead, so a fresh clone can reach /admin before any mail
# provider exists. The production build refuses to pretend it sent anything.
# RESEND_API_KEY=re_...

# The From address on that email. Must be on a domain Resend has verified.
# MAIL_FROM=Smash Queue <noreply@your-domain>

# OPTIONAL. QR codes and share links use the origin the request actually
# arrived on, so this is only needed behind a proxy that rewrites the Host
# header. Setting it wrong is worse than leaving it unset.
# APP_BASE_URL=https://your-domain

# Wall clock the app renders times in. Timestamps are stored as instants, so
# this is purely a display setting, but leaving it unset on a UTC server shows
# every check-in four hours early for a Gulf group.
NEXT_PUBLIC_TIME_ZONE=Asia/Dubai

# OPTIONAL. Sign-in addresses that should run the platform (create communities,
# appoint organizers, reach /hq). Checked on sign-in and written to the
# database, so after those people have signed in once this can be removed.
# PLATFORM_ADMINS=you@example.com,colleague@example.com

# Authorises the daily purge of communities deleted more than 30 days ago.
# Vercel's scheduler sends it automatically once it is set on the project.
#   openssl rand -hex 32
# CRON_SECRET=
