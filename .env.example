# Neon Postgres connection string (pooled). Get it from the Neon console or
# from the Vercel integration, which sets it automatically in deployments.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Signs the session QR check-in tokens. Set a long random string in production:
#   openssl rand -base64 32
QR_SECRET=change-me-before-you-share-a-real-session

# Public URL of the deployment. QR codes and share links are built from this,
# so a wrong value here points every QR code at the wrong host.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Wall clock the app renders times in. Timestamps are stored as instants, so
# this is purely a display setting, but leaving it unset on a UTC server shows
# every check-in four hours early for a Gulf group.
NEXT_PUBLIC_TIME_ZONE=Asia/Dubai
